# Configuración pública conectada al backend real (Django).
VITE_API_URL=/api/v1
# Catálogo: real (por defecto, Django) o mock (solo pruebas de regresión de la demo). Ver docs/api/catalogo.md#10-frontend.
VITE_CATALOGO_API=real
# Sesión: real (por defecto, Django) o mock (demo aislada). real exige VITE_CATALOGO_API=real.
VITE_AUTH_API=real
# Mapa del taller (FEAT-GEO-02). Opcionales y sin claves: vacías usan OpenStreetMap
# (tiles con atribución y búsqueda Nominatim, máx. 1 petición/s, sin autocompletado).
# Ver docs/arquitectura/frontend.md#mapa-y-geocodificación.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_GEOCODING_URL=https://nominatim.openstreetmap.org/search
API_PROXY_TARGET=http://127.0.0.1:8000
