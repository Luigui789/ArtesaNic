# Exclusivamente desarrollo local. Las variables exportadas tienen prioridad.
# Si el volumen ya contiene datos, conservar sus credenciales originales de forma local.
DJANGO_SECRET_KEY=clave-ejemplo-solo-desarrollo-local-no-usar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=false
DJANGO_COOKIE_SAMESITE=Lax
POSTGRES_DB=artesanic
POSTGRES_USER=artesanic
POSTGRES_PASSWORD=contrasena-ejemplo-solo-desarrollo-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_VOLUME=artesanic_postgres_data
FRONTEND_PORT=5173
BACKEND_PORT=8000
VITE_API_URL=/api/v1
# Catálogo: real (por defecto, Django) o mock (solo pruebas de regresión de la demo). Ver docs/api/catalogo.md#10-frontend.
VITE_CATALOGO_API=real
# Sesión: real (por defecto, Django) o mock (demo aislada). real exige VITE_CATALOGO_API=real.
# Ver docs/arquitectura/frontend.md.
VITE_AUTH_API=real
# Mapa del taller (FEAT-GEO-02). Opcionales y sin claves: vacías usan OpenStreetMap
# (tiles con atribución y búsqueda Nominatim, máx. 1 petición/s, sin autocompletado).
# Ver docs/arquitectura/frontend.md#mapa-y-geocodificación.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_GEOCODING_URL=https://nominatim.openstreetmap.org/search

# Media local fuera de PostgreSQL; Compose fija /workspace/media en backend_media.
# En host, omitir para usar apps/backend/media.
# DJANGO_MEDIA_ROOT=
# Comprobantes de pago privados, fuera de MEDIA_ROOT y sin URL pública (D-AUD10-05).
# Compose fija /workspace/private_media en backend_private_media. En host, omitir para
# usar apps/backend/private_media (ignorado por Git).
# DJANGO_PRIVATE_MEDIA_ROOT=
