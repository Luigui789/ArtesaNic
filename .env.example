# Exclusivamente desarrollo local. Las variables exportadas tienen prioridad.
# Si el volumen ya contiene datos, conservar sus credenciales originales de forma local.
DJANGO_SECRET_KEY=clave-ejemplo-solo-desarrollo-local-no-usar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=false
DJANGO_COOKIE_SAMESITE=Lax
POSTGRES_DB=artesanic
POSTGRES_USER=artesanic
POSTGRES_PASSWORD=contrasena-ejemplo-solo-desarrollo-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_VOLUME=artesanic_postgres_data
FRONTEND_PORT=5173
BACKEND_PORT=8000
VITE_API_URL=/api/v1
# Catálogo: mock (por defecto) o real (Django). Ver docs/api/catalogo.md#10-frontend.
VITE_CATALOGO_API=mock
# Sesión: mock (por defecto, demo) o real (Django). real exige VITE_CATALOGO_API=real.
# Ver docs/arquitectura/frontend.md.
VITE_AUTH_API=mock
